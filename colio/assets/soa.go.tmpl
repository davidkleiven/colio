type {{ .StructName }}Soa struct {
{{- range .Fields }}
	{{ .Name }} []{{ .Type }} {{ .Tags }}
{{- end }}
}

func (v *{{ .StructName }}Soa) Allocate(n int) {
{{- range .Fields }}
	v.{{ .Name }} = make([]{{ .Type }}, n)
{{- end }}
}

func (v *{{ .StructName }}Soa) Columns() []colio.Column {
	return []colio.Column{
	{{- range .Fields }}
		{Name: "{{ .Name }}", Tags: {{ .Tags }}, Ptr: &v.{{ .Name }}},
	{{- end }}
	}
}

func (v *{{ .StructName }}Soa) Cap() int {
	return min(
	{{- range .Fields }}
		len(v.{{ .Name }}),
	{{- end }}
	)
}

func (v *{{ .StructName }}Soa) ToAos() iter.Seq[{{ .StructName }}] {
	return func(yield func({{ .StructName }}) bool) {
		for i := range v.Cap() {
			item := {{ .StructName }}{
			{{- range .Fields }}
				{{ .Name }}: v.{{ .Name }}[i],
			{{- end }}
			}
		if !yield(item) {
			return
		}
	}
	}
}

func (v *{{ .StructName }}Soa) Delete(i int) {
	{{- range .Fields }}
		v.{{ .Name }}[i] = v.{{ .Name }}[len(v.{{ .Name }}) - 1]
		v.{{ .Name }} = v.{{ .Name }}[:len(v.{{ .Name }}) - 1]
	{{- end }}
}

func (v *{{ .StructName }}Soa) FromAos(aos []{{ .StructName }}) *{{ .StructName }}Soa {
	v.Allocate(len(aos))
	for i, item := range aos {
		{{- range .Fields }}
			v.{{ .Name }}[i] = item.{{ .Name }}	
		{{- end }}
	}
	return v
}

func (v *{{ .StructName }}Soa) At(i int) {{ .StructName }} {
	return {{ .StructName }} {
		{{- range .Fields }}
			{{ .Name }}: v.{{ .Name }}[i],
		{{- end }}
	}
}
